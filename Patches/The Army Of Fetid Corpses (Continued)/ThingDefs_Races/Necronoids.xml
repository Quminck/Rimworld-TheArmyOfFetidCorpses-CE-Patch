			<hediffname>Painless</hediffname>
			</li>
		</value>
	</Operation>

		<!-- ======================== Race Properties ======================== -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[
		defName="Necronoid_FetidGhoul"
