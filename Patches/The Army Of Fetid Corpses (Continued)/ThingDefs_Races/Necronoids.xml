<Patch>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="BaseNecronoid"]/statBases</xpath>
		<value>
			<SmokeSensitivity>-1.0</SmokeSensitivity>
			<ToxicEnvironmentResistance>1.0</ToxicEnvironmentResistance>
			<MeatAmount>0</MeatAmount>
			<LeatherAmount>0</LeatherAmount>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="BaseNecronoid"]/race</xpath>
		<value>	 
			<hediffGiverSets Inherit="false"/>
			<bleedRateFactor>0.10</bleedRateFactor>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[contains(defName, 'Necronoid_') and race]/comps</xpath>
