<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]</xpath>
		<value>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Humanoid</bodyShape>
			</li>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/race/baseBodySize</xpath>
		<value>
			<baseBodySize>1.0</baseBodySize>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/race/baseHealthScale</xpath>
		<value>
			<baseHealthScale>1.0</baseHealthScale>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/statBases</xpath>
		<value>
			<MeleeDodgeChance>0.25</MeleeDodgeChance>
			<MeleeCritChance>0.05</MeleeCritChance>
			<MeleeParryChance>0.45</MeleeParryChance>
			<PainShockThreshold>1.0</PainShockThreshold>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>fists</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.2</cooldownTime>
					<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
					<armorPenetrationBlunt>2.5</armorPenetrationBlunt>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>fists</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.2</cooldownTime>
					<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
					<armorPenetrationBlunt>2.5</armorPenetrationBlunt>
				</li>	
				<li Class="CombatExtended.ToolCE">
					<label>elbow blades</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>22</power>
					<cooldownTime>1.4</cooldownTime>
					<linkedBodyPartsGroup>Arms</linkedBodyPartsGroup> 
					<armorPenetrationSharp>15.0</armorPenetrationSharp> 
					<armorPenetrationBlunt>6.5</armorPenetrationBlunt>
				</li>
			</tools>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/statBases</xpath>
		<value>
			<ArmorRating_Sharp>16.0</ArmorRating_Sharp>
			<ArmorRating_Blunt>42.0</ArmorRating_Blunt>
			<AimingAccuracy>1.25</AimingAccuracy>
			<ShootingAccuracyPawn>1.15</ShootingAccuracyPawn>
			<NightVisionEfficiency>0.75</NightVisionEfficiency>
			<MeatAmount>0</MeatAmount>
			<LeatherAmount>0</LeatherAmount>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_ArmorDurability">
				<Durability>1500</Durability>
				<Regenerates>false</Regenerates>
				<MinArmorPct>0.10</MinArmorPct>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Necronoid_FleshMarine"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>1.2</ArmorRating_Sharp>
						<parts>
							<li>Torso</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>1.2</ArmorRating_Blunt>
						<parts>
							<li>Torso</li>
						</parts>
					</li>
				</stats>
			</li>
		</value>
	</Operation>		
