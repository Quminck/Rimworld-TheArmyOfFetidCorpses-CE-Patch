<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/FactionDef[defName="Necronoid"]/maxPawnCostPerTotalPointsCurve</xpath>
		<value>
			<maxPawnCostPerTotalPointsCurve>
				<points>
					<li>(400,200)</li>
					<li>(1000,300)</li>
					<li>(1300,1000)</li>
					<li>(2000,2000)</li>
					<li>(100000,10000)</li>
				</points>
