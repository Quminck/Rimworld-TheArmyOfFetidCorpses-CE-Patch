			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>2.2</cooldownTime>
					<armorPenetrationBlunt>2.65</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>1.6</cooldownTime>
					<armorPenetrationBlunt>1.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>8</power>
					<extraMeleeDamages>
						<li>
							<def>NecronoidCutDamage</def>
							<amount>2</amount>
							<chance>0.25</chance>
						</li>
					</extraMeleeDamages>
					<cooldownTime>1.6</cooldownTime>
					<armorPenetrationSharp>4.5</armorPenetrationSharp>
					<armorPenetrationBlunt>0.9</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>
	
		<!-- ======================== Boneshard rifle ======================== -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Gun_BoneshardRifle</defName>
		<statBases>
			<Mass>3.8</Mass>
			<Bulk>9.7</Bulk>
			<SightsEfficiency>1.0</SightsEfficiency>
			<NightVisionEfficiency_Weapon>0.1</NightVisionEfficiency_Weapon> 
			<SwayFactor>1.53</SwayFactor>
			<ShotSpread>0.08</ShotSpread>
			<RangedWeapon_Cooldown>0.68</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<warmupTime>1.1</warmupTime>
			<range>48</range>
			<burstShotCount>5</burstShotCount>
			<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
			<muzzleFlashScale>6</muzzleFlashScale>
			<recoilAmount>1.44</recoilAmount>
			<defaultProjectile>Bullet_Bone_Rifle</defaultProjectile>
			<soundCast>Shot_Necronoid_Pistol</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
		</Properties>	
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
			<aiUseBurstMode>true</aiUseBurstMode>
			<aimedBurstShotCount>3</aimedBurstShotCount>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AR</li>
		</weaponTags>
	</Operation>
	
