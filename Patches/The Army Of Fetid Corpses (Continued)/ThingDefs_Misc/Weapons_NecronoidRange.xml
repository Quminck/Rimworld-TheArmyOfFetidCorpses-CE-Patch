						<li>
							<def>NecronoidCutDamage</def>
							<amount>2</amount>
							<chance>0.05</chance>
						</li>
					</extraMeleeDamages>
					<cooldownTime>1.6</cooldownTime>
					<armorPenetrationSharp>4.5</armorPenetrationSharp>
					<armorPenetrationBlunt>0.9</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
