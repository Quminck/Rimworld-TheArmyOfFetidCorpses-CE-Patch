<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>The Army Of Fetid Corpses (Continued)</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer" or defName="Gun_CleansingRocketLauncher"]/tools</xpath>
					<value>
						<tools>
			
							<li Class="CombatExtended.ToolCE">
								<label>Blunt</label>
								<capacities>
									<li>Blunt</li>
								</capacities>
								<armorPenetrationBlunt>3.455</armorPenetrationBlunt>
								<power>10</power>
								<cooldownTime>2</cooldownTime>
								<linkedBodyPartsGroup>Handle</linkedBodyPartsGroup>
							</li>
			  		  
						</tools>
					</value>
				</li>
	
						<!-- =============== Heavy Flamer =============== -->
				<li Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/description</xpath>
					<value>
						<description>A heavy long-range flamethrower capable of spreading fire over a wide area. It highly effective against Necronoid structures and large swarms</description>
					</value>
				</li>
				
				<li Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/costList</xpath>
					<value>
						<costList>
							<Steel>110</Steel>
							<ComponentIndustrial>8</ComponentIndustrial>
						</costList>
					</value>
				</li>
				
				<li Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/statBases</xpath>
					<value>
						<statBases Inherit="False">
							<MaxHitPoints>100</MaxHitPoints>
							<Flammability>0</Flammability>			
							<DeteriorationRate>2</DeteriorationRate>
							<Beauty>0</Beauty>
							
							<Mass>21</Mass>
							<Bulk>11.4</Bulk>
						  
							<MarketValue>1100</MarketValue>
							<WorkToMake>63000</WorkToMake>
						  
							<SightsEfficiency>0.9</SightsEfficiency>
							<NightVisionEfficiency_Weapon>0</NightVisionEfficiency_Weapon>
							
							<SwayFactor>1.28</SwayFactor>
							<ShotSpread>2.5</ShotSpread>
							
							<RangedWeapon_Cooldown>1.75</RangedWeapon_Cooldown>
						</statBases>
					</value>
				</li>
				
				<li Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/verbs</xpath>
					<value>
						<verbs>
							<li Class="CombatExtended.VerbPropertiesCE">
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>True</hasStandardCommand>
								
								<warmupTime>2.5</warmupTime>
								
								<range>21</range>
								<minRange>4.0</minRange>
								
								<burstShotCount>15</burstShotCount>
								<ticksBetweenBurstShots>3</ticksBetweenBurstShots>
								<muzzleFlashScale>12</muzzleFlashScale>
								
								<recoilAmount>0.34</recoilAmount>
								
								<defaultProjectile>BulletHVFuel</defaultProjectile>
								<soundCast>Shot_MiniFlameblaster</soundCast>
								
								<targetParams>
									<canTargetLocations>True</canTargetLocations>
								</targetParams>
							</li>
						</verbs>
					</value>
				</li>
		
				<li Class="PatchOperationRemove" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/comps/li[@Class="Necro.CompProperties_ReloadableWeapon"]</xpath> 
				</li>
				
				<li Class="PatchOperationAdd" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>45</magazineSize>
							<reloadTime>5</reloadTime>
							<ammoSet>AmmoSetHVFuel</ammoSet>
						</li>
						
						<li Class="CombatExtended.CompProperties_FireModes">
							<noSingleShot>true</noSingleShot>                 
						</li>
					</value>
				</li>
				
				<li Class="PatchOperationAdd" MayRequire="Ludeon.Rimworld.Biotech">
					<xpath>Defs/ThingDef[defName="Gun_HeavyFlamer"]</xpath>
					<value>
						<weaponTags>
							<li>GunHeavy</li>
							<li>CE_AI_AOE</li>
						</weaponTags>
					</value>
				</li>

		 <!-- =============== (Cleansing) Imperial rocket launcher  =============== -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/label	</xpath>
					<value>
						<label>Imperial Rocket Launcher</label>
					</value>
				</li>
						
				<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/description</xpath>
					<value>
						<description>A heavy single-shot rocket launcher specifically designed to fire anti-necronoid rockets.</description>
					</value>
				</li>
			
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/costList</xpath>
					<value>
						<costList>
							<Steel>60</Steel>
							<Plasteel>90</Plasteel>
							<ComponentSpacer>4</ComponentSpacer>
						</costList>
					</value>
				</li>	
				
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/statBases</xpath>
					<value>
						<statBases Inherit="False">				
							<MaxHitPoints>100</MaxHitPoints>
							<Flammability>0</Flammability>			
							<DeteriorationRate>2</DeteriorationRate>
							<Beauty>0</Beauty>
							
							<Mass>24</Mass>
							<Bulk>15.25</Bulk>
					  
							<!--MarketValue>2100</MarketValue-->
							<WorkToMake>57000</WorkToMake>
					  
							<SightsEfficiency>2.8</SightsEfficiency>
							<NightVisionEfficiency_Weapon>0.9</NightVisionEfficiency_Weapon>
							
							<SwayFactor>3.15</SwayFactor>
							<ShotSpread>0.01</ShotSpread>
							<RangedWeapon_Cooldown>2.05</RangedWeapon_Cooldown>
						</statBases>
					</value>
				</li>
				
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/verbs</xpath>
					<value>
						<verbs>
							<li Class="CombatExtended.VerbPropertiesCE">
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								
								<hasStandardCommand>True</hasStandardCommand>
								<warmupTime>2.5</warmupTime>
								
								<range>62</range>
								
								<burstShotCount>1</burstShotCount>
								<muzzleFlashScale>20</muzzleFlashScale>
								
								<defaultProjectile>BulletANBrocket</defaultProjectile>
								<soundCast>InfernoCannon_Fire</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								
								<targetParams>
								  <canTargetLocations>True</canTargetLocations>
								</targetParams>
							</li>
						</verbs>
					</value>
				</li>
		
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/comps/li[@Class="Necro.CompProperties_ReloadableWeapon"]</xpath> 
				</li>
				
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/comps</xpath>
					<value>
					
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>1</magazineSize>
							<reloadTime>4.4</reloadTime>
							<ammoSet>AmmoSetANBrocket</ammoSet>
						</li>
						
						<li Class="CombatExtended.CompProperties_FireModes">    
							<aiAimMode>AimedShot</aiAimMode>							
						</li>
					</value>
				</li>
				
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/weaponTags</xpath>
						<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]</xpath>
							<value>
								<weaponTags />
							</value>
					</nomatch>
				</li>
			
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="Gun_CleansingRocketLauncher"]/weaponTags</xpath>
					<value>
						<weaponTags Inherit="False">
							<li>GunHeavy</li>
							<li>CE_AI_AOE</li>
						</weaponTags>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>