<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationReplace" MayRequire="Ludeon.Rimworld.Biotech">
		<xpath>Defs/ThingDef[@Name="NecroWeaponsBase"]/tools
		</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>2.2</cooldownTime>
					<armorPenetrationBlunt>2.65</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>1.6</cooldownTime>
					<armorPenetrationBlunt>1.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Stab</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.6</cooldownTime>
					<armorPenetrationBlunt>1.8</armorPenetrationBlunt>
					<armorPenetrationSharp>1.4</armorPenetrationSharp>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

		<!-- ====================== Boneshard rifle craftable ====================== -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Gun_Craftable_BoneshardRifle</defName>
		<statBases>
			<Mass>3.7</Mass>
			<Bulk>11.6</Bulk>
			<SightsEfficiency>1</SightsEfficiency>
			<NightVisionEfficiency_Weapon>0</NightVisionEfficiency_Weapon> 
			<SwayFactor>1.33</SwayFactor>
			<ShotSpread>0.08</ShotSpread>
			<RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
			<MarketValue>1600</MarketValue>
			<WorkToMake>78000</WorkToMake>								
		</statBases>
		<costList>
			<Steel>45</Steel>
			<Plasteel>20</Plasteel>
			<ComponentSpacer>1</ComponentSpacer>
			<Necro_Meat>150</Necro_Meat>
		</costList>					
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<ai_AvoidFriendlyFireRadius>2</ai_AvoidFriendlyFireRadius>
			<warmupTime>1</warmupTime>
			<range>50</range>
			<burstShotCount>5</burstShotCount>
			<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
			<muzzleFlashScale>2</muzzleFlashScale>
			<recoilAmount>1.34</recoilAmount>
			<defaultProjectile>Bullet_Rifle_Bone_Craftable</defaultProjectile>
			<soundCast>Shot_Necronoid_Pistol</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>4</reloadTime>
			<ammoSet>AmmoSet_Rifle_Bone_Craftable</ammoSet> 
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiAimMode>AimedShot</aiAimMode> 
		</FireModes>
		<weaponTags>
			<li>CE_AI_AR</li>
		</weaponTags>
	</Operation>

