								<power>8</power>
								<cooldownTime>2.2</cooldownTime>
								<armorPenetrationBlunt>2.65</armorPenetrationBlunt>
								<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
							</li>
							<li Class="CombatExtended.ToolCE">
								<label>barrel</label>
								<capacities>
									<li>Blunt</li>
								</capacities>
