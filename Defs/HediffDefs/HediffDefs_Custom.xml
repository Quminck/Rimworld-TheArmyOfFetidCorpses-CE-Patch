			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-15</severityPerDay>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
		</comps>		
		<stages>
			<li>
				<minSeverity>0.15</minSeverity>
				<label>low</label>
				<statFactors>
					<MoveSpeed>0.90</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>0.35</minSeverity>
				<label>medium</label>
				<statFactors>
					<MoveSpeed>0.75</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>0.70</minSeverity>
				<label>high</label>
				<statFactors>
					<MoveSpeed>0.60</MoveSpeed>
				</statFactors>
			</li>
			<li>
				<minSeverity>0.90</minSeverity>
				<label>maximum</label>
				<statFactors>
					<MoveSpeed>0.50</MoveSpeed>
				</statFactors>
			</li>
		</stages>		
	</HediffDef>	
</Defs>
