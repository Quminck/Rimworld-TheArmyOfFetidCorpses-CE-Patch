<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- =================== Necronoids =================== -->

	<DamageDef>
		<defName>NecronoidBiteDamage</defName>
		<label>infected bite</label>

		<workerClass>DamageWorker_Bite</workerClass>
		<externalViolence>true</externalViolence>
		<deathMessage>{0} has been bitten to death by a monster.</deathMessage>
		
		<hediff>Bite</hediff> 
		<hediffSolid>Crack</hediffSolid>
		
		<harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
		<armorCategory>Sharp</armorCategory>
		<overkillPctToDestroyPart>0~0.3</overkillPctToDestroyPart>
		
		<additionalHediffs>
			<li>
				<hediff>BloodLoss</hediff>
				<severityPerDamageDealt>0.001</severityPerDamageDealt>
			</li>
			
			<li>
				<hediff>Necronoid_InfectionOne</hediff>
				<severityPerDamageDealt>0.005</severityPerDamageDealt>
			</li>		
		</additionalHediffs>
	</DamageDef>
	
	
	
		<!-- =================== Weapons =================== -->
	
	<DamageDef ParentName="Flame">
		<defName>HellfireFlame</defName>
		<label>Hell fire</label>
		<additionalHediffs>
			<li>
				<hediff>PrometheumSoaked</hediff>
				<severityPerDamageDealt>0.05</severityPerDamageDealt>
			</li>
			<li>
				<hediff>HellfireSlowed</hediff>
				<severityPerDamageDealt>0.004</severityPerDamageDealt>
			</li>
		</additionalHediffs>
	</DamageDef>	

</Defs>
