		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.45, 0.95)</drawSize> 
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>BulletToxic</damageDef>
			<damageAmountBase>6</damageAmountBase>
			<armorPenetrationSharp>6.5</armorPenetrationSharp>
			<armorPenetrationBlunt>3.0</armorPenetrationBlunt>
			<pelletCount>12</pelletCount>
			<spreadMult>10</spreadMult>
			<speed>85</speed>	
			<dropsCasings>false</dropsCasings>	
		</projectile>
	</ThingDef>
	
