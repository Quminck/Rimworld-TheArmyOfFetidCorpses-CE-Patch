<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<CombatExtended.AmmoCategoryDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>ToxicAmmo</defName>
		<label>Toxic Ammo</label>
		<labelShort>TA</labelShort>
		<description>A toxic ammunition made from chemically neutralized Necronoid biological material. It is the result of numerous attempts to replicate Necronoid technology.</description>
	</CombatExtended.AmmoCategoryDef>
	
	<!-- ==================== AmmoSet ========================== -->
  
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Rifle_Bone_Craftable</defName> 
		<label>Toxic assault round</label>
		<ammoTypes>
			<Ammo_Rifle_Bone_Craftable>Bullet_Rifle_Bone_Craftable</Ammo_Rifle_Bone_Craftable>	
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Sniper_Bone_Craftable</defName>   
		<label>Toxic sniper round</label>
		<ammoTypes>
			<Ammo_Sniper_Bone_Craftable>Bullet_Sniper_Bone_Craftable</Ammo_Sniper_Bone_Craftable>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Shotgun_Bone_Craftable</defName> 
		<label>Toxic buckshot</label>
		<ammoTypes>
			<Ammo_Shotgun_Bone_Craftable>Bullet_Shotgun_Bone_Craftable</Ammo_Shotgun_Bone_Craftable>	
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
	<!-- ==================== Rifle round ==================== -->
					
	<!-- ==================== Ammo ========================== -->
 
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SmallAmmoBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Ammo_Rifle_Bone_Craftable</defName>                                
		<label>Toxic rifle round</label>
		<description>A makeshift rifle round containing a highly toxic compound. Safe from the infection, but extremely toxic to living organisms.</description>
		<statBases>
			<Mass>0.02</Mass>
			<Bulk>0.02</Bulk>
		</statBases>
		<graphicData>
			<texPath>Things/Ammo/Toxic/Assault</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<ammoClass>ToxicAmmo</ammoClass>
		<thingCategories>
			<li>AmmoRifles</li>    
		</thingCategories>         
	</ThingDef>
	
			<!-- =================== Projectiles ===================-->
	
	<ThingDef ParentName="BaseBulletCE" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Bullet_Rifle_Bone_Craftable</defName>                              
		<label>toxic bullet</label>
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.0, 1.0)</drawSize> 			
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE" MayRequire="Ludeon.Rimworld.Biotech">
			<damageDef>BulletToxic</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<armorPenetrationSharp>10.0</armorPenetrationSharp>
			<armorPenetrationBlunt>3.0</armorPenetrationBlunt>
			<speed>120</speed>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>
	
		<!-- =================== Recipes ===================-->
				
	<RecipeDef ParentName="ChargeAmmoRecipeBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>MakeAmmo_Rifle_Bone_Craftable</defName>
		<label>make toxic round x150</label>
		<description>Craft 150 toxic rounds.</description>
		<jobString>Making toxic rounds</jobString>
		<researchPrerequisite>NecroWeapons</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Necro_Meat</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Neutroamine</li>
					</thingDefs>
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>			
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Necro_Meat</li>
				<li>Neutroamine</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Rifle_Bone_Craftable>150</Ammo_Rifle_Bone_Craftable>
		</products>
		<workAmount>7200</workAmount>
	</RecipeDef>
	
		<!-- =================== Sniper round =================== -->
					
		<!-- ==================== Ammo ========================== -->
		
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SmallAmmoBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Ammo_Sniper_Bone_Craftable</defName>                                
		<label>Toxic sniper round</label>
		<description>A specialized rifle round containing a highly concentrated toxic compound, designed for long-range use.</description>
		<statBases>
			<Mass>0.03</Mass>
			<Bulk>0.03</Bulk>
		</statBases>
		<graphicData>
			<texPath>Things/Ammo/Toxic/Sniper</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<ammoClass>ToxicAmmo</ammoClass>
		<thingCategories>
			<li>AmmoRifles</li>    
		</thingCategories>         
	</ThingDef>
	
			<!-- =================== Projectiles ===================-->
			
	<ThingDef ParentName="BaseBulletCE" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Bullet_Sniper_Bone_Craftable</defName>                              
		<label>toxic bullet</label>
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.50, 0.85)</drawSize> 
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE" MayRequire="Ludeon.Rimworld.Biotech">
			<damageDef>BulletToxic</damageDef>
			<damageAmountBase>14</damageAmountBase>
			<armorPenetrationSharp>15.0</armorPenetrationSharp>
			<armorPenetrationBlunt>4.0</armorPenetrationBlunt>
			<speed>130</speed>	
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>
	
			<!-- =================== Recipes ===================-->
				
	<RecipeDef ParentName="ChargeAmmoRecipeBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>MakeAmmo_Sniper_Bone_Craftable</defName>
		<label>make toxic spike x100</label>
		<description>Craft 100 toxic spikes.</description>
		<jobString>Making toxic spikes</jobString>
		<researchPrerequisite>NecroWeapons</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Necro_Meat</li>
					</thingDefs>
				</filter>
				<count>70</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Neutroamine</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Necro_Meat</li>
				<li>Neutroamine</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Sniper_Bone_Craftable>100</Ammo_Sniper_Bone_Craftable>
		</products>
		<workAmount>9000</workAmount>
	</RecipeDef>
	
				<!-- =================== Shotgun round =================== -->
					
				<!-- =================== Ammunition ===================-->
	
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Ammo_Shotgun_Bone_Craftable</defName>                                
		<label>Toxic buckshot</label>
		<description>A makeshift buckshot load containing numerous toxic pellets.</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<graphicData>
			<texPath>Things/Ammo/Toxic/Buckshot</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.05</Mass>
			<Bulk>0.06</Bulk>
		</statBases>
		<ammoClass>ToxicAmmo</ammoClass>
		<thingCategories>
			<li>AmmoShotguns</li>
		</thingCategories>         
	</ThingDef>
	
			<!-- =================== Projectiles ===================-->
	
