<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- =========================== Ammo category =========================== -->
	<ThingCategoryDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoCategoryHVFuel</defName>
		<label>Condensed napalm fuel</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberFuel</iconPath>
	</ThingCategoryDef>
  
		<!-- =========================== AMMUNITION SET ============================= -->
  
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSetHVFuel</defName> 
		<label>Condensed napalm Fuel</label>
		<ammoTypes>
			<AmmoHVFuel>BulletHVFuel</AmmoHVFuel>    
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
  
		<!-- ============================ AMMUNITION ============================== -->
  
	<ThingDef Class="CombatExtended.AmmoDef" Name="AmmoHVFuelBase" ParentName="HeavyAmmoBase" Abstract="True" MayRequire="Ludeon.Rimworld.Biotech">
		<description>A condense napalm fuel designed specifically for heavy flamethrowers.</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoCategoryHVFuel</li>        
		</thingCategories>
	</ThingDef>
  
			<!-- Ammunition stats -->
  
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoHVFuelBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoHVFuel</defName>                                 
		<label>Condensed napalm Fuel</label>
		<graphicData>
			<texPath>Things/Ammo/FuelTank/Incendiary</texPath>
			<graphicClass>Verse.Graphic_StackCount</graphicClass>
		</graphicData>
		<stackLimit>250</stackLimit>
		<statBases>
			<Mass>0.08</Mass>
			<Bulk>0.1</Bulk>
			
			<MarketValue>0.8</MarketValue>
		</statBases>
		<ammoClass>NapalmFuel</ammoClass>
		<cookOffProjectile>BulletHVFuel</cookOffProjectile>              
	</ThingDef>
  
  
  
					<!-- =================== Projectiles ===================-->
  
	<ThingDef Name="BulletHVFuelBase" ParentName="BaseBulletCE" Abstract="True" MayRequire="Ludeon.Rimworld.Biotech">
		<graphicData>
			<texPath>Things/Projectile/Flame_CE</texPath>
			<graphicClass>Verse.Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<speed>20</speed>
			<dropsCasings>true</dropsCasings>
		</projectile>
	</ThingDef>
  
			<!-- Bullet stats -->  
			
	<ThingDef ParentName="BulletHVFuelBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>BulletHVFuel</defName>
		<label>Napalm</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Flame</damageDef> 
			<damageAmountBase>4</damageAmountBase>
	
			<pelletCount>8</pelletCount>  
			<explosionRadius>2</explosionRadius>
			
			<explosionDamageFalloff>true</explosionDamageFalloff>
			<preExplosionSpawnThingDef>FilthPrometheum</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>0.8</preExplosionSpawnChance>
			
			<soundExplode>CE_FlamethrowerExplosion</soundExplode>
			
			<speed>14</speed>
			<flyOverhead>false</flyOverhead>  
			<dropsCasings>false</dropsCasings>
			<ai_IsIncendiary>true</ai_IsIncendiary>
			<screenShakeFactor>0</screenShakeFactor>
		</projectile>
	</ThingDef>






	<RecipeDef ParentName="LauncherAmmoRecipeBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>MakeAmmoHVFuel</defName>
		<label>Make condensed napalm fuel cans x120</label>
		<description>craft 120 condensed napalm fuel cans</description>
		<jobString>making condensed napalm fuel cans</jobString>
		<researchPrerequisite>IncendiaryWeapons</researchPrerequisite>
		<recipeUsers>
			<li>TableMachining</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Prometheum</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Chemfuel</li>
				<li>Prometheum</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<AmmoHVFuel>120</AmmoHVFuel>
		</products>
		<workAmount>9000</workAmount>
	</RecipeDef>
	
</Defs>