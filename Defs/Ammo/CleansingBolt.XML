<?xml version="1.0" encoding="utf-8"?>
<Defs>


			<!-- Ammo category -->-->

	<ThingCategoryDef>
		<defName>AmmoCategoryANBbolt</defName>
		<label>5mm cleansing bolt</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRailgunPistol</iconPath>
	</ThingCategoryDef>
  
			<!-- Ammunition set -->
  
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSetANBbolt</defName>
		<label>5mm cleansing bolt</label>
		<ammoTypes>
		<AmmoANBbolt>BulletANBbolt</AmmoANBbolt>   
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
  
  
  
				<!-- =================== Ammunition ===================-->
  
	<ThingDef Class="CombatExtended.AmmoDef" Name="AmmoANBbolt_Base" ParentName="SpacerAmmoBase" Abstract="True">
		<description>An experimental cleansing sabot bolt designed for bolt carbines. This high-velocity round is capable of penetrating thick armor. The bolt's cleansing element deals increased damage to necronoids.</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoCategoryANBbolt</li> 
		</thingCategories>
	</ThingDef>
  
			<!-- Ammunition stats -->>
  
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoANBbolt_Base">
		<defName>AmmoANBbolt</defName> 
		<label>5mm cleansing bolt</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/MediumMech</texPath>
			<graphicClass>Verse.Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>8.0</MarketValue>
			<Mass>0.055</Mass>
			<Bulk>0.025</Bulk>
		</statBases>
		<ammoClass>RailgunSabot</ammoClass>
		<cookOffProjectile>BulletANBbolt</cookOffProjectile> 
	</ThingDef>
		
	
		
				<!-- =================== Projectiles ===================-->
  
	<ThingDef Name="BulletANBbolt_Base" ParentName="BaseBulletCE" Abstract="True">
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Bolter</texPath>
			<graphicClass>Verse.Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<speed>260</speed>
			<dropsCasings>true</dropsCasings>
		</projectile>
	</ThingDef>
  
				<!-- Bullet stats -->
  
	<ThingDef ParentName="BulletANBbolt_Base">
		<defName>BulletANBbolt</defName>  
		<label>5mm cleansing bolt</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Cleansing</damageDef> 
			<damageAmountBase>15</damageAmountBase>
			<armorPenetrationBlunt>240</armorPenetrationBlunt>
			<armorPenetrationSharp>30</armorPenetrationSharp>
		</projectile>
	</ThingDef>
	
	
	
			<!-- =================== Recipes ===================-->
  
	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmoANBbolt</defName>
		<label>Make 5mm cleansing bolts x100</label>
		<description>Craft 100 5mm cleansing bolts.</description>
		<jobString>Making 5mm cleansing bolts.</jobString>
		<researchPrerequisite>CleansingWeapons</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Neutroamine</li>
					</thingDefs>
				</filter>
				<count>15</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>30</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Plasteel</li>
				<li>Uranium</li>
				<li>Neutroamine</li>
		</thingDefs>
		</fixedIngredientFilter>
		<products>
			<AmmoANBbolt>100</AmmoANBbolt>
		</products>
		<workAmount>9000</workAmount>
	</RecipeDef>
	
</Defs>