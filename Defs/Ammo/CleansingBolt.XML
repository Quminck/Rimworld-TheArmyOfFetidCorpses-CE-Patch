<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingCategoryDef>
		<defName>AmmoCategoryANBbolt</defName>
		<label>Bolter shell (Cleansing)</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRailgunPistol</iconPath>
	</ThingCategoryDef>

		<!-- ==================== AmmoSet ========================== -->
	
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSetANBbolt</defName>
		<label>Bolter shell (Cleansing)</label>
		<ammoTypes>
		<AmmoANBbolt>BulletANBbolt</AmmoANBbolt>   
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
		<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
		<defName>AmmoANBbolt</defName> 
		<label>Bolter shell (Cleansing)</label>
		<description>An experimental cleansing sabot shell designed for bolt carbines. This high-velocity round can penetrate heavy armor. Its cleansing element deals increased damage to Necronoids.</description>
		<statBases>
			<Mass>0.1</Mass>
			<Bulk>0.08</Bulk>
		</statBases>		
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoCategoryANBbolt</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Ammo/Charged/MediumMech</texPath>
			<graphicClass>Verse.Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>RailgunSabot</ammoClass>
	</ThingDef>
		
		<!-- =================== Projectiles ===================-->

	<ThingDef ParentName="BaseBulletCE">
		<defName>BulletANBbolt</defName>  
		<label>Cleansing bolt</label>
			<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Bolter</texPath>
			<graphicClass>Verse.Graphic_Single</graphicClass>
		</graphicData>	
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Cleansing</damageDef> 
			<damageAmountBase>21</damageAmountBase>
			<armorPenetrationBlunt>240</armorPenetrationBlunt>
			<armorPenetrationSharp>20</armorPenetrationSharp>
			<speed>250</speed>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>

		<!-- =================== Recipes ===================-->
	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmoANBbolt</defName>
		<label>make bolter shell (Cleansing) x500</label>
		<description>Craft 500 bolter shells (Cleansing).</description>
		<jobString>Making bolter shells (Cleansing)</jobString>
		<researchPrerequisite>CleansingWeapons</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Neutroamine</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>8</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>			
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Plasteel</li>
				<li>Uranium</li>
				<li>Neutroamine</li>
				<li>ComponentIndustrial</li>
		</thingDefs>
		</fixedIngredientFilter>
		<products>
			<AmmoANBbolt>500</AmmoANBbolt>
		</products>
		<workAmount>7500</workAmount>
	</RecipeDef>
</Defs>