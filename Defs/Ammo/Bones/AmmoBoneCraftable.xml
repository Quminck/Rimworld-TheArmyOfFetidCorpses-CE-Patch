<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<CombatExtended.AmmoCategoryDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>SurgBoneAmmo</defName>
		<label>Surrogate Bone Ammo</label>
		<labelShort>SBA</labelShort>
		<description>Toxic surrogate round made from Necronoid flesh with a neutralized infection. It is the result of numerous attempts to copy necronoid technologies</description>
	</CombatExtended.AmmoCategoryDef>
	
  
			<!-- =================== Ammo set =================== -->
  
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Rifle_Bone_Craftable</defName> 
		<label>Rifle toxic round</label>
		<ammoTypes>
			<Ammo_Rifle_Bone_Craftable>Bullet_Rifle_Bone_Craftable</Ammo_Rifle_Bone_Craftable>	
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Sniper_Bone_Craftable</defName>   
		<label>High-caliber toxic round</label>
		<ammoTypes>
			<Ammo_Sniper_Bone_Craftable>Bullet_Sniper_Bone_Craftable</Ammo_Sniper_Bone_Craftable>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
	
	<CombatExtended.AmmoSetDef MayRequire="Ludeon.Rimworld.Biotech">
		<defName>AmmoSet_Shotgun_Bone_Craftable</defName> 
		<label>Toxic buckshot</label>
		<ammoTypes>
			<Ammo_Shotgun_Bone_Craftable>Bullet_Shotgun_Bone_Craftable</Ammo_Shotgun_Bone_Craftable>	
		</ammoTypes>
	</CombatExtended.AmmoSetDef>
  
  
  
  
				<!-- =================== Rifle Bone =================== -->
					
				<!-- =================== Ammunition ===================-->
  
	<ThingDef Class="CombatExtended.AmmoDef" Name="Ammo_Rifle_Bone_Craftable_Base" ParentName="AmmoBase" Abstract="True" MayRequire="Ludeon.Rimworld.Biotech">
		<description>A makeshift rifle round. It fires a chemically neutralized bone shard. Safe from the infection, but remains extremely toxic for any lifeforms</description>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoRifles</li>    
		</thingCategories>
	</ThingDef>
  
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_Rifle_Bone_Craftable_Base" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Ammo_Rifle_Bone_Craftable</defName>                                
		<label>Toxic round</label>
		<graphicData>
			<texPath>Things/Ammo/BoneAmmo/Common</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.02</Mass>
			<Bulk>0.02</Bulk>
		</statBases>
		<ammoClass>SurgBoneAmmo</ammoClass>
		<cookOffProjectile>Bullet_Rifle_Bone_Craftable</cookOffProjectile>           
	</ThingDef>
	


			<!-- =================== Projectiles ===================-->
  
	<ThingDef Name="Bullet_Rifle_Bone_Craftable_Base" ParentName="BaseBulletCE" Abstract="True" MayRequire="Ludeon.Rimworld.Biotech">
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.0, 1.0)</drawSize> 			
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE" MayRequire="Ludeon.Rimworld.Biotech">
			<damageDef>BulletToxic</damageDef>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="Bullet_Rifle_Bone_Craftable_Base" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>Bullet_Rifle_Bone_Craftable</defName>                              
		<label>toxic bullet</label>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE" MayRequire="Ludeon.Rimworld.Biotech">
			<damageAmountBase>10</damageAmountBase>
			<armorPenetrationSharp>10.0</armorPenetrationSharp>
			<armorPenetrationBlunt>3.0</armorPenetrationBlunt>
			<speed>135</speed>
		</projectile>
	</ThingDef>
	
	
	
		<!-- =================== Recipes ===================-->
				
	<RecipeDef ParentName="ChargeAmmoRecipeBase" MayRequire="Ludeon.Rimworld.Biotech">
		<defName>MakeAmmo_Rifle_Bone_Craftable</defName>
		<label>Make toxic round x200</label>
		<description>Craft 200 toxic rounds.</description>
		<jobString>Making toxic rounds.</jobString>
		<researchPrerequisite>NecroWeapons</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Necro_Meat</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Neutroamine</li>
					</thingDefs>
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>			
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Necro_Meat</li>
				<li>Neutroamine</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Rifle_Bone_Craftable>200</Ammo_Rifle_Bone_Craftable>
		</products>
		<workAmount>7200</workAmount>
	</RecipeDef>
	
	
	
	
	  
