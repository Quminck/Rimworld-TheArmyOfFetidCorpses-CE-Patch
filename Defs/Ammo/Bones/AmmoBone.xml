<?xml version="1.0" encoding="utf-8"?>
<Defs>

  

  
  
				<!-- =================== Projectiles ===================-->
  
	<ThingDef Name="Bullet_Bone_Base" ParentName="BaseBulletCE" Abstract="True">
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Verse.Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>RangedStab</damageDef>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>

					
				
			<!-- ==================== Rifle bone as bullet ====================  -->
  
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Rifle</defName>
		<label>Infected shard bone</label>
		<graphicData>
			<drawSize>(1.0, 1.0)</drawSize> 	
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>18</damageAmountBase>
			<armorPenetrationSharp>10.0</armorPenetrationSharp>
			<armorPenetrationBlunt>5.0</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>8</amount>
					<chance>0.01</chance>
				</li>
			</secondaryDamage>
			<speed>135</speed>
			<suppressionFactor>0.45</suppressionFactor>		
		</projectile>
	</ThingDef>
	
	

			<!-- ==================== Shotgun bone as bullet ====================  -->>
	
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Shotgun</defName>
		<label>Infected bone fragments</label>
		<graphicData>
			<drawSize>(0.35, 0.85)</drawSize>
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>10</damageAmountBase>
			<armorPenetrationSharp>6.0</armorPenetrationSharp>
			<armorPenetrationBlunt>4.0</armorPenetrationBlunt>
			<pelletCount>8</pelletCount>
			<spreadMult>12</spreadMult>
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>6</amount>
					<chance>0.002</chance>
				</li>
			</secondaryDamage>
			<speed>105</speed>
			<suppressionFactor>0.20</suppressionFactor>		
		</projectile>
	</ThingDef>
	
	
	
			<!-- ==================== Sniper bone as bullet ====================  -->
	
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Sniper</defName>                               <!-- MAIN BULLET -->
		<label>Infected bone spike</label>
		<graphicData>
			<drawSize>(0.9, 1.3)</drawSize>
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>26</damageAmountBase>
			<armorPenetrationSharp>18.0</armorPenetrationSharp>
			<armorPenetrationBlunt>6.0</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>10</amount>
					<chance>0.15</chance>
				</li>
			</secondaryDamage>
			<speed>150</speed>
			<suppressionFactor>0.15</suppressionFactor>		
		</projectile>
	</ThingDef>
	
	
	
			<!-- ==================== Plague bile as bullet ====================  -->
	
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Plague</defName>                               <!-- MAIN BULLET -->
		<label>Plague bile</label>
		<graphicData>
			<drawSize>(1.0, 1.0)</drawSize>
			<texPath>Things/Misc/Bullets/Projectile_Green</texPath>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>PlagueBile</damageDef> 
			<damageAmountBase>3</damageAmountBase>
 
			<explosionRadius>2.0</explosionRadius>
			<pelletCount>3</pelletCount> 
			<spreadMult>5</spreadMult>
						
			<explosionDamageFalloff>true</explosionDamageFalloff>
			<preExplosionSpawnThingDef>Filth_SpentAcid</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>0.75</preExplosionSpawnChance>
			
			<soundExplode>CE_FlamethrowerExplosion</soundExplode>
			
			<speed>20</speed>
			<dropsCasings>false</dropsCasings>
			<ai_IsIncendiary>true</ai_IsIncendiary>
			
			<screenShakeFactor>0</screenShakeFactor>
		</projectile>
	</ThingDef>
  
  
  
  			<!-- ==================== Auto cannon bone as bullet ====================  -->
	
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_AutoCannon</defName>                               <!-- MAIN BULLET -->
		<label>Infected thigh-bone spike</label>
		<graphicData>
			<drawSize>(1.95, 2.25)</drawSize>
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>23</damageAmountBase>
			<armorPenetrationSharp>14.0</armorPenetrationSharp>
			<armorPenetrationBlunt>7.0</armorPenetrationBlunt>	
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>19</amount>
					<chance>0.05</chance>
				</li>
			</secondaryDamage>
			<speed>145</speed>
			<suppressionFactor>2.25</suppressionFactor>		
		</projectile>
	</ThingDef>
	
	
	
	  			<!-- ==================== Turret bone as bullet ====================  -->
	
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Turret</defName>                               <!-- MAIN BULLET -->
