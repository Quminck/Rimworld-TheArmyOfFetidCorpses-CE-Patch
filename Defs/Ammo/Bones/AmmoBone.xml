<?xml version="1.0" encoding="utf-8"?>
<Defs>

  

  
  
				<!-- =================== Projectiles ===================-->
  
	<ThingDef Name="Bullet_Bone_Base" ParentName="BaseBulletCE" Abstract="True">
		<graphicData>
			<texPath>Things/Misc/Bullets/Projectile_Infected</texPath>
			<graphicClass>Verse.Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>RangedStab</damageDef>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>

					
				
			<!-- ==================== Rifle bone as bullet ====================  -->
  
	<ThingDef ParentName="Bullet_Bone_Base">
		<defName>Bullet_Bone_Rifle</defName>
		<label>Infected shard bone</label>
		<graphicData>
			<drawSize>(1.0, 1.0)</drawSize> 	
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>20</damageAmountBase>
			<armorPenetrationSharp>13.5</armorPenetrationSharp>
			<armorPenetrationBlunt>5.0</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>8</amount>
					<chance>0.01</chance>
				</li>
			</secondaryDamage>
			<speed>135</speed>
			<suppressionFactor>0.75</suppressionFactor>		
		</projectile>
	</ThingDef>
	
	

