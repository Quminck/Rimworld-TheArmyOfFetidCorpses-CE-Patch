		<graphicData>
			<drawSize>(1.5, 1.1)</drawSize>
		</graphicData>
		
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>7</damageAmountBase>
			<armorPenetrationSharp>8.0</armorPenetrationSharp>
			<armorPenetrationBlunt>4.5</armorPenetrationBlunt>	
			<secondaryDamage>
				<li>
					<def>NecronoidRangeDamage</def>
						<amount>4</amount>
					<chance>0.005</chance>
