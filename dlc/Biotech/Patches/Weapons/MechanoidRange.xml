<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Gun_MilitorScopedRifle" 
		or defName="Gun_UnderTaker" 
		or defName="Gun_RevolvingAutoCannon"
		]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>1.76</cooldownTime>
					<armorPenetrationBlunt>1.48</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>			

	<!-- ====================== Militor scoped rifle ====================== -->	   
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Gun_MilitorScopedRifle</defName>
		<statBases>
			<Mass>4.25</Mass>
			<Bulk>12.0</Bulk>
			<SightsEfficiency>1.85</SightsEfficiency>
			<NightVisionEfficiency_Weapon>0.40</NightVisionEfficiency_Weapon> 
			<SwayFactor>1.51</SwayFactor>
			<ShotSpread>0.02</ShotSpread>
			<RangedWeapon_Cooldown>0.45</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<ai_AvoidFriendlyFireRadius>2</ai_AvoidFriendlyFireRadius>
			<warmupTime>1.45</warmupTime>
			<range>54</range>
			<burstShotCount>5</burstShotCount>
			<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
			<muzzleFlashScale>8</muzzleFlashScale>
			<recoilAmount>1.97</recoilAmount>
			<defaultProjectile>Bullet_792x57mmMauser_FMJ</defaultProjectile>
			<soundCast>Shot_Sturmgewehr_44</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>4.0</reloadTime>
			<ammoSet>AmmoSet_792x57mmMauser</ammoSet>
		</AmmoUser>					
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode> 
			<aimedBurstShotCount>3</aimedBurstShotCount>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AR</li>
		</weaponTags>
	</Operation>

